# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/punchai

# ─── Authentication ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave empty to allow all origins (development only).
# Example: https://app.punchai.com,https://widget.punchai.com
ALLOWED_ORIGINS=

# ─── AI & Embeddings ────────────────────────────────────────────────────────
# OpenAI is used as primary; Gemini is the fallback. At least one is required.
OPENAI_API_KEY=sk-your_openai_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# ─── Vector Database (Pinecone) ──────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
# Index must be configured for 1024 dimensions (matches EXPECTED_DIMENSION in embeddingService.ts)
PINECONE_INDEX_NAME=punchai-index

# ─── File Storage ────────────────────────────────────────────────────────────
# "local" stores uploads on disk (default, development only)
# "s3"    stores uploads in AWS S3 (recommended for production)
STORAGE_PROVIDER=local

# Required only when STORAGE_PROVIDER=s3:
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
