# Server Configuration
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/punchai

# Authentication
# You can generate a random secret key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# AI & Embeddings
# OpenAI is used as primary, Gemini is used as fallback (at least one is required)
OPENAI_API_KEY=sk-your_openai_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=punchai-index
